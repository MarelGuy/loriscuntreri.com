---
// src/components/LanguageToggle.astro
const { pathname } = Astro.url;

const isEnglish = pathname.startsWith("/en");
const isItalian = pathname.startsWith("/it");

let targetUrl;

if (isEnglish) {
    targetUrl = pathname.replace(/^\/en/, "/it") || "/it";
} else if (isItalian) {
    targetUrl = pathname.replace(/^\/it/, "/en") || "/en";
} else {
    targetUrl = "/en";
}
---

<a
    href={targetUrl}
    id="lang-switch-btn"
    class="fixed bottom-6 left-6 z-50 flex items-center justify-center gap-2 bg-[#111] text-white border border-gray-700 px-4 py-2 rounded-full shadow-[0_0_15px_rgba(0,0,0,0.5)] hover:scale-105 hover:border-cyan-500 hover:shadow-[0_0_15px_rgba(8,145,178,0.4)] transition-all duration-300"
    title="Swap Language"
>
    <span
        class={`text-xl transition-all duration-300 ${!isEnglish ? "drop-shadow-md" : "opacity-40 grayscale"}`}
    >
        🇮🇹
    </span>

    <span class="text-sm font-bold text-gray-500">/</span>

    <span
        class={`text-xl transition-all duration-300 ${isEnglish ? "drop-shadow-md" : "opacity-40 grayscale"}`}
    >
        🇬🇧
    </span>
</a>

<script>
    const langBtn = document.getElementById("lang-switch-btn");

    if (langBtn) {
        langBtn.addEventListener("click", () => {
            const currentPercentage = window.latestScrollPercentage || 0;

            sessionStorage.setItem("savedScroll", currentPercentage.toString());
        });
    }
</script>
