---
// src/components/pages/Redirect.astro
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>Loris Cuntreri</title>

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <script>
            const pathname = window.location.pathname;

            let redirectPath = "/en/home";

            if (pathname.startsWith("/it/") || pathname === "/it") {
                redirectPath = "/it/home";
            }

            window.location.replace(redirectPath);
        </script>
    </head>
    <body class="bg-black"> </body>
</html>
