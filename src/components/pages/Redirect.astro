---
// src/components/ClientRedirect.astro
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>Loris Cuntreri</title>
        <script>
            // Read the actual URL path from the browser
            const pathname = window.location.pathname;
            let redirectPath = "/en/home";

            // Check if they were trying to access an Italian route
            if (pathname.startsWith("/it/") || pathname === "/it") {
                redirectPath = "/it/home";
            }

            // Instantly replace the current page with the correct home page
            window.location.replace(redirectPath);
        </script>
    </head>
    <body class="bg-black"> </body>
</html>
