---
// src/components/pages/Projects.astro

import Button from "../Button.astro";

export interface Project {
    projectTitle: string;
    description: string;
    technologies: string[];
    projectLink: string;
}

export interface Props {
    pageTitle: string;
    buttonText: string;
    projects: Project[];
}

const { pageTitle, buttonText, projects } = Astro.props;
---

<section
    class="min-h-screen flex flex-col items-center pt-32 pb-24 px-6 w-full max-w-5xl mx-auto"
>
    <h1
        class="text-5xl md:text-6xl font-black text-cyan-600 mb-24 tracking-wide text-center"
    >
        {pageTitle}
    </h1>

    <div class="flex flex-col w-full gap-32">
        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-20 w-full mb-30"
        >
            {
                projects.map((project) => (
                    <div class="flex flex-col items-center text-center w-full bg-[#111] border border-gray-800 rounded-3xl p-8 md:p-10 hover:shadow-[0_0_25px_rgba(8,145,178,0.3)] hover:-translate-y-2 transition-all duration-300 ease-out h-full">
                        <div class="grow flex flex-col items-center w-full">
                            <h2 class="text-3xl md:text-4xl font-bold text-[#5ab4c5] mb-6 tracking-wide uppercase">
                                {project.projectTitle}
                            </h2>

                            <p class="text-gray-200 text-base md:text-lg font-light max-w-2xl mb-8 leading-relaxed">
                                {project.description}
                            </p>

                            <div class="w-full max-w-md mx-auto flex flex-col items-start mb-10 px-4 md:px-8">
                                <ol class="list-decimal list-inside text-white text-base md:text-lg space-y-2 text-left font-medium">
                                    {project.technologies.map((tech) => (
                                        <li>{tech}</li>
                                    ))}
                                </ol>
                            </div>
                        </div>

                        <Button
                            buttonHref={project.projectLink}
                            buttonText={buttonText}
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>
