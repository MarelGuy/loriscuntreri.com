---
// src/components/pages/WhoAmI.astro

const {
    text,
    buttonText,
    buttonHref,
    contactTitle,
    mailLabel,
    linkedinLabel,
    githubLabel,
} = Astro.props;
---

<section
    class="min-h-screen flex flex-col items-center justify-center grow w-full max-w-5xl mx-auto px-6 pt-24 pb-20"
>
    <div
        class="flex flex-col md:flex-row items-center md:items-start justify-center w-full gap-12 md:gap-20 mb-20"
    >
        <div
            class="w-full md:w-1/2 space-y-6 text-lg md:text-xl text-gray-200 font-light flex flex-col justify-center"
        >
            {text}
        </div>
    </div>

    <a
        href={buttonHref}
        class="bg-cyan-50 text-cyan-600 font-bold text-xl px-10 py-4 rounded-full
        shadow-[0_0_15px_rgba(8,145,178,0.4)]
        hover:shadow-[0_0_30px_rgba(8,145,178,0.7)] hover:-translate-y-1 hover:scale-105
        transition-all duration-300 ease-out"
    >
        {buttonText}
    </a>
</section>

<section
    class="w-full min-h-screen bg-[#eafafa] py-24 px-6 flex flex-col items-center justify-center text-black"
>
    <h2
        class="text-4xl md:text-5xl font-black text-center text-[#5ab4c5] mb-20 tracking-wide"
    >
        {contactTitle}
    </h2>

    <div
        class="flex flex-col md:flex-row items-center md:items-start justify-center gap-16 md:gap-24 w-full max-w-5xl"
    >
        <div class="flex flex-col items-center text-center gap-4 flex-1">
            <a
                href="mailto:irertnuc.loris@gmail.com"
                class="w-16 h-16 bg-[#333333] rounded-full flex items-center justify-center text-white cursor-pointer transition-all duration-300 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(51,51,51,0.5)]"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-7 h-7"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                    ></path>
                </svg>
            </a>
            <div>
                <p
                    class="font-bold text-[#5ab4c5] text-lg tracking-wide uppercase"
                >
                    {mailLabel}
                </p>
                <a
                    href="mailto:irertnuc.loris@gmail.com"
                    class="text-black text-lg mt-1 block"
                    >irertnuc.loris@gmail.com</a
                >
            </div>
        </div>

        <div class="flex flex-col items-center text-center gap-4 flex-1">
            <a
                href="https://www.linkedin.com/in/lc0/"
                target="_blank"
                rel="noopener noreferrer"
                class="w-16 h-16 bg-[#333333] rounded-full flex items-center justify-center text-white cursor-pointer transition-all duration-300 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(51,51,51,0.5)]"
            >
                <svg fill="currentColor" viewBox="0 0 24 24" class="w-6 h-6"
                    ><path
                        d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                    ></path></svg
                >
            </a>
            <div>
                <p
                    class="font-bold text-[#5ab4c5] text-lg tracking-wide uppercase"
                >
                    {linkedinLabel}
                </p>
                <a
                    href="https://www.linkedin.com/in/lc0/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-black text-lg mt-1 underline hover:text-cyan-600 transition-colors block"
                    >Loris Cuntreri</a
                >
            </div>
        </div>

        <div class="flex flex-col items-center text-center gap-4 flex-1">
            <a
                href="https://github.com/MarelGuy"
                target="_blank"
                rel="noopener noreferrer"
                class="w-16 h-16 bg-[#333333] rounded-full flex items-center justify-center text-white cursor-pointer transition-all duration-300 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(51,51,51,0.5)]"
            >
                <svg fill="currentColor" viewBox="0 0 24 24" class="w-7 h-7"
                    ><path
                        d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                    ></path></svg
                >
            </a>
            <div>
                <p
                    class="font-bold text-[#5ab4c5] text-lg tracking-wide uppercase"
                >
                    {githubLabel}
                </p>
                <a
                    href="https://github.com/MarelGuy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-black text-lg mt-1 underline hover:text-cyan-600 transition-colors block"
                    >MarelGuy</a
                >
            </div>
        </div>
    </div>
</section>
