---
// src/components/Navbar.astro

let currentPath = Astro.url.pathname;

let isEnglish = currentPath.startsWith("/en");

let currentPage = currentPath === `/` ? `/` : currentPath.replace(/\/$/, "");
const links = [
    { labelIt: "Home", labelEn: "Home", href: "/home" },
    { labelIt: "Chi sono", labelEn: "Who am I", href: "/whoami" },
    { labelIt: "Progetti", labelEn: "Projects", href: "/projects" },
    { labelIt: "CV", labelEn: "CV", href: "/Loris_Cuntreri_CV.pdf" },
];
---

<nav
    class="fixed top-0 left-0 w-full z-50 bg-transparent flex justify-center items-center gap-3 sm:gap-6 md:gap-12 pt-4 md:pt-8 pb-4 px-2 flex-wrap"
>
    {
        links.map((link) => {
            let href = (isEnglish ? "/en" : "/it") + link.href;

            return (
                <a
                    href={href}
                    class={
                        currentPage === href
                            ? "bg-cyan-50 px-4 py-2 md:px-8 font-bold text-sm md:text-base text-cyan-700 rounded-full shadow-md text-center"
                            : "bg-black px-4 py-2 md:px-8 font-bold text-sm md:text-lg hover:text-cyan-300 transition-colors rounded-full drop-shadow-md text-center"
                    }
                >
                    {isEnglish ? link.labelEn : link.labelIt}
                </a>
            );
        })
    }
</nav>
