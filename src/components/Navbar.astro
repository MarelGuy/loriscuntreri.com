---
// src/components/Navbar.astro

let currentPath = Astro.url.pathname;

let isEnglish = currentPath.startsWith("/en");

let currentPage = currentPath === `/` ? `/` : currentPath.replace(/\/$/, "");

const links = [
    { labelIt: "Home", labelEn: "Home", href: "/home" },
    { labelIt: "Chi sono", labelEn: "Who am I", href: "/whoami" },
    { labelIt: "Progetti", labelEn: "Projects", href: "/projects" },
    { labelIt: "CV", labelEn: "CV", href: "/cv" },
];
---

<nav
    class="fixed top-0 left-0 w-full z-50 bg-transparent flex justify-center items-center gap-12 pt-8 pb-4"
>
    {
        links.map((link) => {
            let href = (isEnglish ? "/en" : "/it") + link.href;

            return (
                <a
                    href={href}
                    class={
                        currentPage === href
                            ? "bg-cyan-50 px-8 py-2 font-bold text-cyan-700  rounded-full shadow-md"
                            : "bg-black px-8 py-2 font-bold text-lg hover:text-cyan-300 transition-colors rounded-full drop-shadow-md"
                    }
                >
                    {isEnglish ? link.labelEn : link.labelIt}
                </a>
            );
        })
    }
</nav>
