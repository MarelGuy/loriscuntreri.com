---
// src/components/Footer.astro

let {
    directLinks,
    homeHref,
    whoami,
    whoamiHref,
    projects,
    projectsHref,
    cvHref,
} = Astro.props;
---

<footer
    class="w-full bg-black text-white min-h-[50vh] flex flex-col justify-center py-20 px-6"
>
    <div class="max-w-4xl mx-auto w-full flex flex-col gap-16">
        <h2 class="text-2xl md:text-3xl font-bold text-cyan-600 tracking-wide">
            Loris Cuntreri | Software Engineer
        </h2>

        <div class="flex flex-wrap gap-24 md:gap-40">
            <div class="flex flex-col gap-4">
                <h3 class="text-xl font-bold mb-2">{directLinks}</h3>
                <a
                    href={homeHref}
                    class="text-lg text-gray-300 hover:text-cyan-300 transition-colors"
                    >Home</a
                >
                <a
                    href={whoamiHref}
                    class="text-lg text-gray-300 hover:text-cyan-300 transition-colors"
                    >{whoami}</a
                >
                <a
                    href={projectsHref}
                    class="text-lg text-gray-300 hover:text-cyan-300 transition-colors"
                    >{projects}</a
                >
                <a
                    href={cvHref}
                    class="text-lg text-gray-300 hover:text-cyan-300 transition-colors"
                    >CV</a
                >
            </div>

            <div class="flex flex-col gap-4">
                <h3 class="text-xl font-bold mb-2">Social</h3>
                <a
                    href="mailto:irertnuc.loris@gmail.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-gray-300 hover:text-cyan-300 transition-colors"
                    >Email</a
                >
                <a
                    href="https://www.linkedin.com/in/lc0/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-gray-300 hover:text-cyan-300 transition-colors"
                    >LinkedIn</a
                >
                <a
                    href="https://github.com/MarelGuy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-gray-300 hover:text-cyan-300 transition-colors"
                    >Github</a
                >
            </div>
        </div>

        <div
            class="flex flex-col sm:flex-row justify-between items-center pt-8 mt-4 gap-6"
        >
            <p class="text-lg text-gray-200">ver: 1.0/1.0</p>
            <p class="text-lg text-gray-200">made with ❤️ by Loris Cuntreri</p>
            <p class="text-lg text-gray-200">design by Feni</p>
        </div>
    </div>
</footer>
